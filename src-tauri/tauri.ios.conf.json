{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "net.jcode.jtype",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JType",
        "visible": true
      }
    ],
    "security": {
      "capabilities": ["mobile"]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["jtype"],
          "appLink": false
        }
      ]
    }
  }
}
