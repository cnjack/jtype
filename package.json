{
  "name": "markdown-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "npm run build && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:web": "playwright test --config playwright.web.config.ts",
    "web:dev": "cargo run --manifest-path services/jtype-web/Cargo.toml",
    "web:test": "cargo test --manifest-path services/jtype-web/Cargo.toml",
    "preview": "vite preview",
    "tauri": "tauri",
    "i18n:extract": "lingui extract",
    "i18n:extract:web": "lingui extract --config services/jtype-web/frontend/lingui.config.ts",
    "i18n:compile": "lingui compile",
    "i18n:compile:web": "lingui compile --config services/jtype-web/frontend/lingui.config.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@lingui/core": "^6.0.1",
    "@lingui/react": "^6.0.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3.4.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "katex": "^0.16.45",
    "marked": "^18.0.2",
    "mermaid": "^11.14.0",
    "morphdom": "^2.7.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^6.0.1",
    "@lingui/cli": "^6.0.1",
    "@lingui/format-po": "^6.0.1",
    "@lingui/vite-plugin": "^6.0.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2",
    "@types/morphdom": "^2.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.6.2",
    "vite": "^8.0.0"
  }
}
