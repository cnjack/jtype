}

async fn dashboard_page() -> Html<String> {
    Html(app_page(
        "JType Dashboard",
        "Dashboard",
        "Workspaces",
        r#"
        <div class="toolbar"><input id="workspace-name" placeholder="New workspace name"><button onclick="createWorkspace()">Create workspace</button></div>
        <div id="workspaces" class="list"></div>
        <script>
          async function api(path, options = {}) {
            const token = localStorage.getItem('jtype.token') || '';
            const res = await fetch(path, { ...options, headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}`, ...(options.headers || {}) } });
            if (!res.ok) throw new Error(await res.text());
            return res.json();
          }
          async function load() {
            try {
              const data = await api('/api/v1/workspaces');
              document.querySelector('#workspaces').innerHTML = data.workspaces.map(w => `<a class="item" href="/workspaces/${w.id}"><strong>${w.name}</strong><span>${w.role} · ${w.documentCount} docs · ${(w.storageBudgetBytes/1024/1024).toFixed(0)} MB</span></a>`).join('') || '<p>No workspaces yet.</p>';
            } catch (e) { document.querySelector('#workspaces').innerHTML = `<p>${e}</p><p><a href="/login">Login first</a></p>`; }
          }
          async function createWorkspace() {
            const name = document.querySelector('#workspace-name').value || 'Untitled Workspace';
            await api('/api/v1/workspaces', { method: 'POST', body: JSON.stringify({ name }) });
            await load();
          }
          load();
        </script>
        "#,
    ))
}

async fn settings_page() -> Html<String> {
    Html(app_page(
        "JType Settings",
        "Settings",
        "Personal settings",
        r#"
        <div class="item"><strong>Cloud service</strong><span>Use this page for profile, custom domain, title, certificates, and themes as the UI grows.</span></div>
        <div class="item"><strong>Custom domain</strong><span id="domain-status">Loading...</span></div>
        <div class="stack" style="margin-top:18px">
          <input id="new-domain" placeholder="yourdomain.com">
          <button onclick="addDomain()">Add domain</button>
        </div>
        <div id="domains" class="list" style="margin-top:18px"></div>
        <div class="item" style="margin-top:18px"><strong>SSL Certificate</strong><span>Upload after domain is verified.</span></div>
        <div class="stack" style="margin-top:10px">
          <select id="cert-domain-id"><option value="">Select verified domain</option></select>
          <textarea id="cert-pem" rows="4" placeholder="-----BEGIN CERTIFICATE-----&#10;..."></textarea>
          <textarea id="key-pem" rows="4" placeholder="-----BEGIN PRIVATE KEY-----&#10;..."></textarea>
          <button onclick="uploadCert()">Upload certificate</button>
          <p id="cert-status"></p>
        </div>
        <script>
          async function api(path, options = {}) {
            const token = localStorage.getItem('jtype.token') || '';
            const res = await fetch(path, { ...options, headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token, ...(options.headers || {}) } });
            if (!res.ok) throw new Error(await res.text());
            return res.json();
          }
          async function loadDomains() {
            try {
              const domains = await api('/api/v1/domains');
              document.querySelector('#domain-status').textContent = domains.length + ' domain(s)';
              document.querySelector('#domains').innerHTML = domains.map(d => '<div class="item"><strong>' + d.domain + '</strong><span>Status: ' + d.status + (d.sslStatus ? ' · SSL: ' + d.sslStatus : '') + ' · TXT: ' + d.dnsTxtRecord + '</span>' + (d.status === 'pending' ? '<button onclick="verifyDomain(\'' + d.id + '\')">Verify</button>' : '') + '</div>').join('') || '<p>No domains yet.</p>';
              const sel = document.querySelector('#cert-domain-id');
              sel.innerHTML = '<option value="">Select verified domain</option>' + domains.filter(d => d.status === 'verified').map(d => '<option value="' + d.id + '">' + d.domain + '</option>').join('');
            } catch (e) { document.querySelector('#domain-status').textContent = String(e); }
          }
          async function addDomain() {
            const domain = document.querySelector('#new-domain').value;
            await api('/api/v1/domains', { method: 'POST', body: JSON.stringify({ domain }) });
            await loadDomains();
          }
          async function verifyDomain(id) {
            await api('/api/v1/domains/' + id + '/verify', { method: 'POST', body: '{}' });
            await loadDomains();
          }
          async function uploadCert() {
            const domainId = document.querySelector('#cert-domain-id').value;
            if (!domainId) { document.querySelector('#cert-status').textContent = 'Select a domain first'; return; }
            const body = { certChainPem: document.querySelector('#cert-pem').value, privateKeyPem: document.querySelector('#key-pem').value };
            try { await api('/api/v1/domains/' + domainId + '/certificate', { method: 'POST', body: JSON.stringify(body) }); document.querySelector('#cert-status').textContent = 'Certificate uploaded'; await loadDomains(); }
            catch (e) { document.querySelector('#cert-status').textContent = String(e); }
          }
          loadDomains();
        </script>
        "#,
    ))
}

async fn workspace_page(Path(workspace_id): Path<String>) -> Html<String> {
    Html(app_page(
        "JType Workspace",
        "Workspace",
        "Cloud editor",
        &format!(
            r#"
        <div class="toolbar"><input id="path" value="index.md"><button onclick="loadDoc()">Load</button><button onclick="saveDoc()">Save</button></div>
        <textarea id="content" style="box-sizing:border-box;width:100%;height:420px;border:1px solid #d6d3d1;border-radius:8px;padding:14px;font:14px ui-monospace,SFMono-Regular,Consolas,monospace"></textarea>
        <p id="status"></p>
        <script>
          const workspaceId = '{}';
          async function api(path, options = {{}}) {{
            const token = localStorage.getItem('jtype.token') || '';
            const res = await fetch(path, {{ ...options, headers: {{ 'Content-Type':'application/json', Authorization:`Bearer ${{token}}`, ...(options.headers || {{}}) }} }});
            if (!res.ok) throw new Error(await res.text());
            return res.json();
          }}
          async function loadDoc() {{
            const pull = await api(`/api/v1/workspaces/${{workspaceId}}/sync/pull`, {{ method:'POST', body: JSON.stringify({{ sinceClock: 0 }}) }});
            const wanted = document.querySelector('#path').value;
            const doc = pull.documents.find(d => d.relativePath === wanted) || pull.documents[0];
            if (doc) {{ document.querySelector('#path').value = doc.relativePath; document.querySelector('#content').value = doc.content; }}
            document.querySelector('#status').textContent = pull.conflicts.length ? `${{pull.conflicts.length}} conflict(s)` : 'Loaded';
          }}
          async function saveDoc() {{
            const body = {{ relativePath: document.querySelector('#path').value, content: document.querySelector('#content').value }};
            await api(`/api/v1/workspaces/${{workspaceId}}/documents`, {{ method:'PUT', body: JSON.stringify(body) }});
            document.querySelector('#status').textContent = 'Saved';
          }}
          loadDoc().catch(e => document.querySelector('#status').textContent = e);
        </script>
        "#,
            workspace_id
        ),
    ))
}

