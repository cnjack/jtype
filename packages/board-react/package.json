{
  "name": "jtype-board-react",
  "version": "0.1.2",
  "description": "Embeddable React kanban board for jtype cloud workspaces (the shared BoardSurface behind the desktop + web boards, wired to an instance-based API client).",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/scope-css.mjs",
    "test": "cd ../.. && npx playwright test --config playwright.unit.config.ts boardReact && npx playwright test --config playwright.board.config.ts board-react-embed.spec.ts --workers=1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@lingui/babel-plugin-lingui-macro": "^6.0.1",
    "@lingui/cli": "^6.0.1",
    "@lingui/core": "^6.0.1",
    "@lingui/format-po": "^6.0.1",
    "@lingui/react": "^6.0.1",
    "@lingui/vite-plugin": "^6.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "postcss": "^8.5.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.6.2",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
