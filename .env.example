MYSQL_ROOT_PASSWORD=jtype-root
MYSQL_DATABASE=jtype
MYSQL_USER=jtype
MYSQL_PASSWORD=jtype-local

RUSTFS_ACCESS_KEY=jtype
RUSTFS_SECRET_KEY=jtype-local-secret
RUSTFS_BUCKET=jtype-content

JTYPED_DATABASE_URL=mysql://jtype:jtype-local@127.0.0.1:3306/jtype
# JTYPED_STORAGE_* are defaults only. An admin can override them at runtime in
# the web UI (Admin → Storage); saved values take precedence over these vars.
JTYPED_STORAGE_ENDPOINT=http://127.0.0.1:9000
JTYPED_STORAGE_BUCKET=jtype-content
JTYPED_STORAGE_ACCESS_KEY=jtype
JTYPED_STORAGE_SECRET_KEY=jtype-local-secret

# JTYPED_SMTP_* are defaults only. An admin can override them at runtime in the
# web UI (Admin → Email); saved values take precedence over these vars. Leave
# unset to disable outbound email (password reset / email verification).
# JTYPED_SMTP_HOST=smtp.example.com
# JTYPED_SMTP_PORT=587
# JTYPED_SMTP_USERNAME=
# JTYPED_SMTP_PASSWORD=
# JTYPED_SMTP_FROM=JType <noreply@example.com>
# JTYPED_SMTP_ENCRYPTION=starttls
